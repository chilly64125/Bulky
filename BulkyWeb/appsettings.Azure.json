{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=tcp:{AZURE_SQL_SERVER}.database.windows.net,1433;Initial Catalog={AZURE_SQL_DATABASE};User Id={AZURE_SQL_USER}@{AZURE_SQL_SERVER};Password={AZURE_SQL_PASSWORD};Encrypt=true;Connection Timeout=30;TrustServerCertificate=false;"
  },
  "Stripe": {
    "SecretKey": "{STRIPE_SECRET_KEY}",
    "PublishableKey": "{STRIPE_PUBLISHABLE_KEY}"
  },
  "EmailSettings": {
    "SmtpServer": "{EMAIL_SMTP_SERVER}",
    "SmtpPort": 587,
    "SenderEmail": "{EMAIL_SENDER}",
    "SenderPassword": "{EMAIL_PASSWORD}"
  },
  "AllowedHosts": "*",
  "CORS": {
    "AllowedOrigins": ["https://yourdomain.com", "https://www.yourdomain.com"]
  }
}
